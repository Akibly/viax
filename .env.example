# Copy to .env and fill in. The API refuses to start if anything required is
# missing, and names exactly what (see backend/app/core/config.py).

VIVAX_ENVIRONMENT=local
VIVAX_LOG_LEVEL=INFO
VIVAX_LOG_FORMAT=console

# --- Supabase -----------------------------------------------------------
# Local values come from `supabase status`. This project runs on the 553xx
# port range because the default 543xx range was already in use.
VIVAX_SUPABASE_URL=http://127.0.0.1:55321
VIVAX_SUPABASE_ANON_KEY=
# Bypasses RLS by design. Backend only. Never ship this in the Flutter bundle.
VIVAX_SUPABASE_SERVICE_ROLE_KEY=
VIVAX_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Supabase Edge Function provider (deployed Flutter app) --------------
NVIDIA_API_KEY=
NVIDIA_CHAT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# --- Optional Python service provider ----------------------------------
# Model provider. OpenRouter fronts many providers behind one key, which is
# what makes the fallback chain possible; the service refuses to boot if the
# chosen provider's key is missing.
VIVAX_LLM_PROVIDER=openrouter
VIVAX_OPENROUTER_API_KEY=

# Supabase Edge Functions read secrets without the VIVAX_ prefix. Set these
# with `supabase secrets set --env-file supabase/.env.local` when deploying.
# These OpenRouter settings are optional when the NVIDIA key above is set.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=openrouter/free
OPENROUTER_EMBED_MODEL=liquid/lfm-2.5-embedding-350m:free

# Free models rate-limit without warning (a 429 was observed during provider
# testing), so requests walk VIVAX_MODEL_FALLBACKS until one answers.
VIVAX_EVALUATION_MODEL=minimax/minimax-m3:free
VIVAX_GENERATION_MODEL=minimax/minimax-m3:free

# Set only when VIVAX_LLM_PROVIDER=anthropic.
VIVAX_ANTHROPIC_API_KEY=

# Embeddings run locally (BAAI/bge-large-en-v1.5, 1024-d) to match the
# halfvec(1024) column and to keep student notes off third-party servers.
# Point the model cache at a drive with room:
# HF_HOME=D:\hf-cache

# --- Guardrails ---------------------------------------------------------
VIVAX_DAILY_TOKEN_BUDGET_PER_USER=250000
VIVAX_MAX_QUESTIONS_PER_SESSION=20
